  {
    "kind": "channelKind",
    "id": "webhook",
    "owner": "builtin",
    "label": {
      "source": "Webhook"
    },
    "hint": {
      "source": "Ether sends a JSON POST with kind, title, message and at. Optionally add a bearer token. Only HTTP 2xx responses count as accepted."

  {
    "kind": "channelKind",
    "id": "smtp",
    "owner": "builtin",
    "label": {
      "source": "Email (SMTP)"
    },
    "hint": {
      "source": "Use your mail provider’s SMTP server and app password. STARTTLS usually uses port 587; implicit TLS uses 465. Authentication is optional for a trusted TLS relay. Recipients can be separated by commas."
    },
    "icon": "mail",
    "order": 50,
    "meta": {
      "fields": [
        {
          "key": "endpoint",
          "kind": "text",
          "label": {
            "source": "SMTP host:port"
          },
          "hint": {
            "source": "The server must support TLS."
          },
          "required": true,
          "secret": true,
          "wide": true
        },
        {
          "key": "smtpMode",
          "kind": "select",
          "label": {
            "source": "Connection security"
          },
          "hint": {},
          "default": "starttls",
          "options": [
            {
              "value": "starttls",
              "label": {
                "source": "STARTTLS (usually 587)"
              }
            },
            {
              "value": "tls",
              "label": {
                "source": "Implicit TLS (usually 465)"
              }
            }
          ]
        },
        {
          "key": "username",
          "kind": "text",
          "label": {
            "source": "Username"
          },
          "hint": {},
          "secret": true
        },
        {
          "key": "password",
          "kind": "secret",
          "label": {
            "source": "Password"
          },
          "hint": {},
          "secret": true
        },
        {
          "key": "from",
          "kind": "text",
          "label": {
            "source": "From address"
          },
          "hint": {},
          "required": true
        },
        {
          "key": "to",
          "kind": "text",
          "label": {
            "source": "To addresses"
          },
          "hint": {},
          "required": true
        }
      ],
      "sendTest": true,
      "selectable": true,
      "formats": [
        "text",
        "html"
      ]
    }
  },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ether.dev/schemas/plugin-manifest.v1.json",
  "title": "Ether plugin manifest (EPP/1)",
  "description": "A Stremio add-on manifest plus the ether block. This schema mirrors the rules enforced by internal/plugins Manifest.Validate; the Go validator is authoritative.",
  "type": "object",
  "required": ["id", "version", "name"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9][a-z0-9-]*)+$",
      "maxLength": 120,
      "description": "Reverse-DNS, lower case, unique, never reused."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-.+][0-9A-Za-z.-]*)?$",
      "description": "SemVer. Updates must increase it."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "description": { "type": "string", "maxLength": 300 },
    "logo": { "type": "string" },
    "background": { "type": "string" },
    "types": { "type": "array", "items": { "type": "string" } },
    "catalogs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id"],
        "properties": {
          "type": { "type": "string" },
          "id": { "type": "string" },
          "name": { "type": "string" },
          "extra": true
        }
      }
    },
    "resources": true,
    "idPrefixes": { "type": "array", "items": { "type": "string" } },
    "behaviorHints": true,
    "ether": {
      "type": "object",
      "required": ["protocol", "kind", "runtime"],
      "properties": {
        "protocol": { "const": 1 },
        "kind": {
          "enum": [
            "source",
            "integration",
            "notification_channel",
            "livetv_source",
            "extension"
          ]
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "onair_content",
              "stream_source",
              "list_source",
              "livetv_channels",
              "subtitles",
              "markers",
              "notify",
              "events",
              "ranking_step",
              "rule_condition",
              "tools",
              "ui"
            ]
          }
        },
        "summary": {
          "type": "string",
          "maxLength": 80,
          "description": "Plain text or a $t: key. Sentence case, no em dashes."
        },
        "author": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "url": { "type": "string" }
          }
        },
        "license": { "type": "string" },
        "repo": { "type": "string" },
        "icon": { "type": "string", "description": "SVG path or URL." },
        "runtime": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["hosted", "remote"] },
            "entry": {
              "type": "string",
              "description": "Compiled JS file. Hosted only."
            },
            "module": {
              "type": "string",
              "description": "WASM file. Hosted only."
            }
          }
        },
        "cluster": { "enum": ["leader", "every_node"] },
        "health": {
          "type": "object",
          "properties": {
            "interval": {
              "type": "string",
              "description": "Go duration, at least 15s."
            }
          }
        },
        "permissions": {
          "type": "object",
          "properties": {
            "network": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(\\*\\.)?([a-z0-9-]+\\.)*[a-z0-9-]+$"
              }
            },
            "catalog": { "enum": ["none", "read"] },
            "viewers": {
              "type": "object",
              "properties": {
                "identity": { "enum": ["none", "granted_viewers", "all"] },
                "watch_history": { "enum": ["none", "granted_viewers", "all"] },
                "write_watch_state": { "enum": ["none", "granted_viewers"] }
              }
            },
            "collections": { "enum": ["none", "write"] },
            "folders": { "enum": ["none", "read"] },
            "secrets": { "type": "array", "items": { "type": "string" } }
          }
        },
        "settings": {
          "description": "Settings schema, {} or {\"$ref\":\"file\"}."
        },
        "strings": {
          "type": "object",
          "description": "Locale to file path or inline key map. en is required when $t: keys are used."
        },
        "schedule": {
          "anyOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["every", "call"],
                "properties": {
                  "every": {
                    "type": "string",
                    "description": "Go duration, at least 15m."
                  },
                  "call": { "type": "string", "pattern": "^/" }
                }
              }
            }
          ]
        },
        "contributes": {
          "type": "object",
          "description": "Per-capability metadata. Mandatory metadata is enforced by the Go validator.",
          "properties": {
            "onairFeeds": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "fields", "maxAge"],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "object",
                    "additionalProperties": {
                      "enum": ["text", "number", "image", "list"]
                    }
                  },
                  "sample": {
                    "type": "object"
                  },
                  "maxAge": {
                    "type": "string"
                  }
                }
              }
            },
            "onairSegments": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name", "duration", "file", "feeds"],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "duration": {
                    "type": "integer",
                    "minimum": 4,
                    "maximum": 600,
                    "multipleOf": 4
                  },
                  "file": {
                    "type": "string"
                  },
                  "feeds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "rating": {
                    "type": "string"
                  }
                }
              }
            },
            "source": {
              "type": "object",
              "required": ["class"],
              "properties": {
                "class": { "enum": ["debrid", "usenet", "indexer", "direct"] },
                "abilities": { "type": "array", "items": { "type": "string" } },
                "limits": true
              }
            },
            "channels": {
              "type": "object",
              "required": ["test"],
              "properties": {
                "refresh": { "type": "string" },
                "test": { "const": true }
              }
            },
            "subtitles": {
              "type": "object",
              "properties": {
                "languages": true,
                "formats": { "type": "array", "items": { "type": "string" } }
              }
            },
            "markers": {
              "type": "object",
              "required": ["kinds"],
              "properties": {
                "kinds": {
                  "type": "array",
                  "items": { "enum": ["intro", "credits", "recap", "preview"] }
                }
              }
            },
            "notification": {
              "type": "object",
              "required": ["sendTest"],
              "properties": {
                "fields": true,
                "sendTest": { "const": true },
                "formats": { "type": "array", "items": { "type": "string" } },
                "maxLength": { "type": "integer", "minimum": 0 }
              }
            },
            "events": {
              "type": "object",
              "required": ["subscribe"],
              "properties": {
                "subscribe": { "type": "array", "items": { "type": "string" } }
              }
            },
            "integration": {
              "type": "object",
              "required": ["category", "adds", "connect"],
              "properties": {
                "category": { "type": "string" },
                "logo": { "type": "string" },
                "adds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": { "type": "string" }
                },
                "connect": { "enum": ["fields", "device_code", "none"] },
                "test": { "type": "boolean" }
              }
            },
            "listSources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["key", "label", "catalog"],
                "properties": {
                  "key": { "type": "string" },
                  "label": { "type": "string", "maxLength": 40 },
                  "hint": { "type": "string", "maxLength": 120 },
                  "catalog": { "type": "string" },
                  "params": true,
                  "maxItems": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2000
                  },
                  "refresh": { "type": "string" }
                }
              }
            },
            "rankingSteps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["key", "label"],
                "properties": {
                  "key": { "type": "string" },
                  "label": { "type": "string", "maxLength": 40 },
                  "hint": { "type": "string", "maxLength": 120 },
                  "editor": true,
                  "budget": true
                }
              }
            },
            "ruleConditions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["key", "label"],
                "properties": {
                  "key": { "type": "string" },
                  "label": { "type": "string", "maxLength": 40 },
                  "operators": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "editor": true
                }
              }
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "title", "description", "inputSchema"],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{1,63}$"
                  },
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "inputSchema": { "type": "object" },
                  "readOnly": { "type": "boolean" },
                  "destructive": { "type": "boolean" },
                  "openWorld": { "type": "boolean" }
                }
              }
            },
            "pages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["key", "label", "route"],
                "properties": {
                  "key": { "type": "string" },
                  "label": { "type": "string", "maxLength": 40 },
                  "route": { "type": "string", "pattern": "^/" },
                  "group": { "type": "string" },
                  "icon": { "type": "string" }
                }
              }
            },
            "slots": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["slot", "key", "label"],
                "properties": {
                  "slot": { "type": "string" },
                  "key": { "type": "string" },
                  "label": { "type": "string", "maxLength": 40 },
                  "route": { "type": "string", "pattern": "^/" },
                  "action": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": { "slot": { "pattern": "^actionMenu\\." } },
                      "required": ["slot"]
                    },
                    "then": {
                      "required": ["action"],
                      "not": { "required": ["route"] }
                    },
                    "else": {
                      "required": ["route"],
                      "not": { "required": ["action"] }
                    }
                  }
                ]
              }
            },
            "commands": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["key", "label", "action"],
                "properties": {
                  "key": { "type": "string" },
                  "label": { "type": "string", "maxLength": 40 },
                  "action": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
